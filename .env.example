# Copy to .env. Values here are read by the API, the workers and docker compose.

API_KEY=dev-api-key
INTERNAL_TOKEN=dev-internal-token

ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mock stack (docker-compose.mock.yml) only: Claude Code's token, from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# How many bots may be in meetings at the same time (one worker process each).
MAX_CONCURRENT_BOTS=2

# direct | proxy | tunnel. The invite dialog can choose another mode per meeting.
DEFAULT_EGRESS_MODE=direct
# proxy mode: an HTTP(S) proxy, e.g. http://user:pass@isp-proxy.example:8000,
# or the Tailscale userspace proxy http://meeting-agent-tailscale:1055
EGRESS_PROXY_URL=

# tunnel mode: the Tailscale container (compose profile "tunnel")
TS_AUTHKEY=
TS_EXIT_NODE=

# Signed-in bot: the label you gave scripts/bot_login.py, and the key that encrypts its sign-in.
BOT_ACCOUNT_LABEL=
FERNET_KEY=

BOT_DISPLAY_NAME=Lexapar Notetaker (recording)
